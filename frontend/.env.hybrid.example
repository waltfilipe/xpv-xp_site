# Modo híbrido — Render (JSON) + Cloudflare R2 (mapas) + Vercel (frontend)
# Copie para frontend/.env.local

# API Render (dados: perfil, lista, compare, scatter)
NEXT_PUBLIC_API_URL=https://pass-scout-api.onrender.com

# CDN dos mapas (conteúdo de frontend/public/static/assets/ na raiz do bucket)
NEXT_PUBLIC_STATIC_ASSETS_URL=https://pub-xxxxxxxx.r2.dev

# NÃO defina NEXT_PUBLIC_STATIC_MODE=1 no modo híbrido
