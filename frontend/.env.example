# URL do backend FastAPI (usado pelo proxy do Next.js no servidor)
BACKEND_URL=http://127.0.0.1:8000

# Opcional — só necessário se o frontend chamar o backend diretamente (sem proxy)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Mapas agregados / heatmaps via CDN ou arquivos em frontend/public/static/assets/
# NEXT_PUBLIC_STATIC_ASSETS_URL=https://seu-bucket.r2.dev
