# Pass Scout — local + Cloudflare Tunnel
PASS_SCOUT_MODE=local
HEAVY_MAPS_ENABLED=1
BACKEND_URL=http://127.0.0.1:8000

# Add your Cloudflare hostname after setup (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://pass-scout.seudominio.com

# Use production Next build for 24/7 hosting (slower first start)
# PASS_SCOUT_PRODUCTION=1
